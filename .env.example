# Base URL of the task-management-api server.
# Vite inlines VITE_* variables into the client bundle, so treat everything here as public.
#
# Local development only. On Vercel this variable must be left UNSET, so the app falls back to
# "" and makes same-origin requests that `vercel.json` proxies to the API. Setting it in
# production would send the browser cross-site to the API host directly, which breaks the
# refresh cookie (it is SameSite=Lax and would no longer be sent).
VITE_API_BASE_URL=http://localhost:3000
